{
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "resultados", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ]
  }
}
